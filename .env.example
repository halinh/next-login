OIDC_WELL_KNOWN_URL=http://localhost:4000/.well-known/openid-configuration
OIDC_CLIENT_ID=next-login-confidential
OIDC_REDIRECT_URI=http://localhost:3000/callback
OIDC_SCOPE=openid profile email
# Token exchange + id_token decode both happen at decode-service's /token proxy,
# which holds this app's client_secret (keyed by OIDC_REDIRECT_URI in its
# OIDC_TOKEN_CLIENTS). This app never holds the secret.
OIDC_TOKEN_PROXY_ENDPOINT=http://localhost:8000/token
